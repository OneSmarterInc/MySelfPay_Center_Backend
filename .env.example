DJANGO_DEBUG=true
ENABLE_DEV_LOGIN=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Empty DATABASE_URL uses a local SQLite development database only.
# Production target: PostgreSQL. Never use company credentials for demo seeding.
DATABASE_URL=

FRONTEND_ORIGIN=http://127.0.0.1:5173
# Configure only when company email setup is approved. Local debug mode sends no email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.invalid
